# ---- InstaBI backend configuration ----
# Copy to backend/.env and adjust. All values are optional; defaults work in
# mock (demo) mode with zero configuration.

# App
INSTABI_DEBUG=false

# Auth
# If INSTABI_ADMIN_PASSWORD is empty, a random password is generated on first
# boot and written to backend/data/admin_password.txt (git-ignored).
INSTABI_ADMIN_USERNAME=admin
INSTABI_ADMIN_PASSWORD=

# Database (SQLite file path)
INSTABI_DB_PATH=

# Scraper provider: "mock" (demo) or "instagrapi" (real)
INSTABI_SCRAPER_PROVIDER=mock

# Instagram credentials (only used by the instagrapi provider)
INSTABI_INSTA_USERNAME=
INSTABI_INSTA_PASSWORD=
INSTABI_INSTA_PROXY=

# Scheduler
# 5-field cron expression (UTC). Default: daily at 03:00.
INSTABI_SCHEDULE_CRON=0 3 * * *
INSTABI_SCHEDULE_ENABLED=true
# Seconds to wait between checking each handle (rate-limit pacing).
INSTABI_PER_HANDLE_DELAY=2.0
# How many recent posts to sample for engagement metrics.
INSTABI_RECENT_MEDIA_COUNT=12
